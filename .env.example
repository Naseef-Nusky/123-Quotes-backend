PORT=5000
DATABASE_URL="postgresql://USER:PASSWORD@HOST:25060/defaultdb?sslmode=require"
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
APP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@123quotes.com
ADMIN_PASSWORD=admin123
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@123quotes.com
SUPER_ADMIN_PASSWORD=superadmin123

# SendGrid — set EMAIL_ENABLED=true to actually send (otherwise emails are logged only)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=info@123quotes.co.uk
SENDGRID_FROM_NAME=123 Quotes
EMAIL_ENABLED=false

# Square Payments
# Use SANDBOX Application ID from Credentials (often sandbox-sq0idb-...), not Production
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
PAYMENTS_ENABLED=false
# Apple Pay: register your domain in Square Dashboard → Apple Pay
# Google Pay: enable in Square Dashboard → Digital wallets (works in Chrome once live)

LOW_TOKEN_THRESHOLD=3
